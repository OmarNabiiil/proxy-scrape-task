APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Shared stack log. ./dev.sh sets this to ../logs/laravel.log
# LOG_PATH=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Redis is required in v1 (queue worker + scrape throttle). Do not install Horizon.
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Go proxy service (internal only, never called from the browser).
GO_PROXY_BASE_URL=http://127.0.0.1:8081

# Browser origins allowed to call GET /api/products.
# Must match where Next.js runs (frontend/.env.local NEXT_PUBLIC_API_URL points back here).
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Shared secret for GET /api/products (sent as the X-API-Key header).
# Must be the same value as frontend NEXT_PUBLIC_API_KEY, or the catalog shows a 401 error.
PRODUCTS_API_KEY=

# Local escape hatch for broken CA bundles. Ignored (always on) in production.
SCRAPE_TLS_VERIFY=true

# Instant hops after a blocked proxy (same scrape). Later hop loop reads this.
SCRAPE_PROXY_MAX_RETRIES=5

# Seconds to wait for the proxy connection; keep it low so dead proxies fail fast.
SCRAPE_CONNECT_TIMEOUT=5

# Seconds to wait for the whole shop page.
SCRAPE_TIMEOUT=20

# Seconds to delay the scrape job when the proxy pool is empty (503).
SCRAPE_PROXY_EMPTY_RELEASE_SECONDS=60
